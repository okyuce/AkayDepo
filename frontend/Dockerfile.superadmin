# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm install

# Copy application
COPY . .

# Build superadmin for production
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npx vite build --config vite.superadmin.config.ts

# Production stage
FROM nginx:alpine
RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/dist-superadmin /usr/share/nginx/html
RUN mv /usr/share/nginx/html/superadmin.html /usr/share/nginx/html/index.html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
